<Window x:Class="Synthetic.Modules.SharedCoordinates.Views.SharedCoordinatesSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Synthetic.Platform.UI;assembly=Synthetic.Core"
        xmlns:theme="clr-namespace:Synthetic.Platform.UI"
        Title="Shared Coordinates Summary"
        Height="420" Width="480" MinHeight="350" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Style="{DynamicResource SyntheticWindowStyle}"
        local:WindowChromeBehavior.EnableWindowCommands="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SyntheticThemeDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Stat Cards -->
            <RowDefinition Height="*"/>    <!-- Details -->
            <RowDefinition Height="Auto"/> <!-- Close Button -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <TextBlock x:Name="TxtSummaryTitle"
                   Grid.Row="0"
                   Text="Shared Coordinates Complete"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                   Margin="0,0,0,14"/>

        <!-- 1. High-Level Stat Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColStat3" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Stat 1 Card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,4,0"
                    Padding="12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtStat1Count"
                               Text="0"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Synthetic.Brushes.Success}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtStat1Label"
                               Text="Stat 1"
                               FontSize="12"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Stat 2 Card -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="2,0,2,0"
                    Padding="12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtStat2Count"
                               Text="0"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Synthetic.Brushes.AccentActive}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtStat2Label"
                               Text="Stat 2"
                               FontSize="12"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Stat 3 Card (Used for Repositioning) -->
            <Border x:Name="BorderStat3"
                    Grid.Column="2"
                    Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="4,0,0,0"
                    Padding="12"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtStat3Count"
                               Text="0"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtStat3Label"
                               Text="Skipped"
                               FontSize="12"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Details Log Area -->
        <Border Grid.Row="2"
                Background="{DynamicResource Synthetic.Brushes.BackgroundBase}"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtSummaryDetails"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- 3. Close Button -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Close"
                    Click="BtnClose_Click"
                    Style="{DynamicResource Synthetic.Styles.PrimaryButton.Right}"
                    Width="90" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
