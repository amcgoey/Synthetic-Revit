<Window x:Class="Synthetic.Modules.SharedCoordinates.Views.MoveLinksToSharedSitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Synthetic.Platform.UI;assembly=Synthetic.Core"
        xmlns:theme="clr-namespace:Synthetic.Platform.UI"
        xmlns:models="clr-namespace:Synthetic.Modules.SharedCoordinates.Models"
        Title="Move Links to Shared Sites"
        Height="620" Width="700" MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Style="{DynamicResource SyntheticWindowStyle}"
        local:WindowChromeBehavior.EnableWindowCommands="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SyntheticThemeDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Subtitle -->
            <RowDefinition Height="Auto"/> <!-- Stat Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Checklist & Search Filter -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Move Links to Shared Sites"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
            <TextBlock Text="Reposition linked unit model instances to match their assigned Shared Sites in full 3D coordinates."
                       FontSize="12"
                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 1. High-Level Stat Cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <!-- Total Instances Card -->
            <Border Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,4,0"
                    Padding="10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalInstancesCount}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Total Instances"
                               FontSize="11"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Out of Sync Card -->
            <Border Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="2,0,2,0"
                    Padding="10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OutOfSyncInstancesCount}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Synthetic.Brushes.AccentActive}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Out of Sync"
                               FontSize="11"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Unassigned Card -->
            <Border Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="4,0,0,0"
                    Padding="10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UnassignedInstancesCount}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Not Shared (Skipped)"
                               FontSize="11"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 2. Checklist & Filter Area -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search & Filter toolbar -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- Search & Filter Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="26"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

                <!-- Quick Select Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Select All"
                            Command="{Binding SelectAllCommand}"
                            Padding="8,4"
                            Margin="0,0,6,0"/>
                    <Button Content="Select None"
                            Command="{Binding SelectNoneCommand}"
                            Padding="8,4"/>
                </StackPanel>
            </Grid>

            <!-- Link Groups DataGrid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredGroups}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource Synthetic.Brushes.BackgroundBase}"
                      BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridTemplateColumn Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:LinkRepositionGroupItem}">
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Link Type Name Column -->
                    <DataGridTextColumn Header="Linked Model Type"
                                        Binding="{Binding TypeName}"
                                        Width="*"
                                        IsReadOnly="True"/>

                    <!-- Total Instances Column -->
                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding TotalInstanceCount}"
                                        Width="65"
                                        IsReadOnly="True"/>

                    <!-- Out of Sync Column -->
                    <DataGridTemplateColumn Header="Out of Sync" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:LinkRepositionGroupItem}">
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OutOfSyncCount}" Value="0">
                                                    <Setter Property="Background" Value="#337A8F75"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Background" Value="#33E65100"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding OutOfSyncCount}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutOfSyncCount}" Value="0">
                                                        <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.AccentActive}"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unassigned Column -->
                    <DataGridTextColumn Header="Not Shared"
                                        Binding="{Binding UnassignedCount}"
                                        Width="90"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 3. Status Bar -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                   Margin="2,0,0,10"/>

        <!-- 4. Footer Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="85" Height="28"
                    Margin="0,0,10,0"/>
            <Button Content="Move Links"
                    Command="{Binding RepositionCommand}"
                    Style="{DynamicResource Synthetic.Styles.PrimaryButton.Right}"
                    Width="110" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
