<Window x:Class="Synthetic.Modules.SharedCoordinates.Views.SyncSharedSitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Synthetic.Shared.UI"
        xmlns:models="clr-namespace:Synthetic.Modules.SharedCoordinates.Models"
        Title="Sync Shared Sites to Levels"
        Height="620" Width="680" MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Style="{DynamicResource SyntheticWindowStyle}"
        local:WindowChromeBehavior.EnableWindowCommands="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Shared/UI/SyntheticTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Description -->
            <RowDefinition Height="Auto"/> <!-- Dropdown Selectors -->
            <RowDefinition Height="*"/>    <!-- Checklist & Filter -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Sync Shared Sites to Levels"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
            <TextBlock Text="Create or update Level-Based Shared Sites from a linked host model in the active unit model."
                       FontSize="12"
                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 1. Dropdown Selectors -->
        <Border Grid.Row="1"
                Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linked Model Selector -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Linked Host Model"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                           Margin="0,0,0,6"/>
                <ComboBox Grid.Row="1" Grid.Column="0"
                          ItemsSource="{Binding LinkedModels}"
                          SelectedItem="{Binding SelectedLinkedModel}"
                          DisplayMemberPath="Name"
                          Height="28"/>

                <!-- Reference Datum Level Selector -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Reference Datum Level (Active Unit Model)"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                           Margin="0,0,0,6"/>
                <ComboBox Grid.Row="1" Grid.Column="2"
                          ItemsSource="{Binding ActiveModelLevels}"
                          SelectedItem="{Binding SelectedReferenceDatumLevel}"
                          DisplayMemberPath="Name"
                          Height="28"/>
            </Grid>
        </Border>

        <!-- 2. Target Levels Checklist Area -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Filter & Selection toolbar -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- Search & Filter Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="26"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"/>

                <!-- Quick Select Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Select All"
                            Command="{Binding SelectAllCommand}"
                            Padding="8,4"
                            Margin="0,0,6,0"/>
                    <Button Content="Select None"
                            Command="{Binding SelectNoneCommand}"
                            Padding="8,4"/>
                </StackPanel>
            </Grid>

            <!-- Levels DataGrid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredTargetSites}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource Synthetic.Brushes.BackgroundBase}"
                      BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridTemplateColumn Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SharedSiteSyncTarget}">
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Level / Site Name Column -->
                    <DataGridTextColumn Header="Level / Site Name"
                                        Binding="{Binding LevelName}"
                                        Width="*"
                                        IsReadOnly="True"/>

                    <!-- Shared Elevation Column -->
                    <DataGridTextColumn Header="Shared Elevation"
                                        Binding="{Binding DisplayElevation}"
                                        Width="130"
                                        IsReadOnly="True"/>

                    <!-- Action Column -->
                    <DataGridTemplateColumn Header="Action" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SharedSiteSyncTarget}">
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SiteExists}" Value="True">
                                                    <Setter Property="Background" Value="#33E65100"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SiteExists}" Value="False">
                                                    <Setter Property="Background" Value="#337A8F75"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ActionText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SiteExists}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.AccentActive}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SiteExists}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 3. Status Bar -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                   Margin="2,0,0,10"/>

        <!-- 4. Footer Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="85" Height="28"
                    Margin="0,0,10,0"/>
            <Button Content="Sync Sites"
                    Command="{Binding SyncCommand}"
                    Style="{DynamicResource Synthetic.Styles.PrimaryButton.Right}"
                    Width="110" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
