<Window x:Class="Synthetic.Modules.SheetIndex.Views.ExportSheetIndexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Dot Sheet Index" Height="580" Width="780"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="#FFFFFF">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title & Subtitle -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Export Dot Sheet Index" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Select project sheets and revision milestones to include in the exported Excel matrix." FontSize="12" Foreground="#AAAAAA" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Selection Source Selection Bar -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Selection Source:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSourceModes}" SelectedItem="{Binding SelectedSourceMode}" VerticalAlignment="Center" Height="26" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555"/>

                <TextBlock Grid.Column="3" Text="Target Set / Schedule:" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding AvailablePrintSets}" SelectedItem="{Binding SelectedPrintSetName}" Width="220" Height="26" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555"/>
                    <ComboBox ItemsSource="{Binding AvailableSchedules}" SelectedItem="{Binding SelectedScheduleName}" Width="220" Height="26" Margin="10,0,0,0" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selection Grids (Sheets & Revisions) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sheets Pane -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sheets" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                    <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,8" Padding="5,3" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#3F3F46"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select All" Command="{Binding SelectAllSheetsCommand}" Padding="8,3" Margin="0,0,5,0" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555"/>
                        <Button Content="Deselect All" Command="{Binding DeselectAllSheetsCommand}" Padding="8,3" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555"/>
                    </StackPanel>

                    <ListBox Grid.Row="3" ItemsSource="{Binding VisibleSheets}" Background="#1E1E1E" BorderBrush="#3F3F46">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Foreground="#FFFFFF" Margin="2,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SheetNumber}" FontWeight="Bold" Width="65"/>
                                        <TextBlock Text="{Binding SheetName}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Revisions Pane -->
            <Border Grid.Column="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Revisions (Issuance Columns)" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select All" Command="{Binding SelectAllRevisionsCommand}" Padding="8,3" Margin="0,0,5,0" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555"/>
                        <Button Content="Deselect All" Command="{Binding DeselectAllRevisionsCommand}" Padding="8,3" Background="#333337" Foreground="#FFFFFF" BorderBrush="#555555"/>
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Revisions}" Background="#1E1E1E" BorderBrush="#3F3F46">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Foreground="#FFFFFF" Margin="2,4">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Date}" FontSize="11" Foreground="#888888"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Export Excel" Command="{Binding ExportCommand}" Width="100" Height="30" Margin="0,0,10,0" Background="#007ACC" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="90" Height="30" Background="#3E3E42" Foreground="#FFFFFF" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

