<Window x:Class="Synthetic.Features.ShadowStudy.Views.ShadowStudyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Synthetic.Platform.UI;assembly=Synthetic.Core"
        xmlns:theme="clr-namespace:Synthetic.Platform.UI"
        xmlns:models="clr-namespace:Synthetic.Features.ShadowStudy.Models;assembly=Synthetic.Core"
        Title="Shadow Study"
        Height="760" Width="660" MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Style="{DynamicResource SyntheticWindowStyle}"
        local:WindowChromeBehavior.EnableWindowCommands="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SyntheticThemeDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Configuration Sections -->
            <RowDefinition Height="Auto"/> <!-- Pinned Footer Actions -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Shadow Study Composite"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
            <TextBlock Text="Export daylight Shadow Frames and blend a calibrated base-ratio Multiply Shadow Composite PNG without modifying the model."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
            <StackPanel>

        <!-- 1. Export Range -->
        <Border Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Export Range"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton Content="Current View"
                                     GroupName="ExportRange"
                                     IsEnabled="{Binding IsCurrentViewEligible}"
                                     IsChecked="{Binding ExportRangeMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:ShadowStudyExportRangeMode.CurrentView}}"
                                     Margin="0,0,16,0"/>
                        <RadioButton Content="Selected Views"
                                     GroupName="ExportRange"
                                     IsChecked="{Binding ExportRangeMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:ShadowStudyExportRangeMode.SelectedViews}}"/>
                    </StackPanel>
                </Grid>

                <!-- Current View Summary -->
                <StackPanel Visibility="{Binding IsCurrentViewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Active View:"
                                   FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActiveViewDisplayName}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                <ItemsControl ItemsSource="{Binding ViewWarnings}"
                              Visibility="{Binding HasViewWarnings, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                                    BorderBrush="{DynamicResource Synthetic.Brushes.Warning}"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="8,5" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Synthetic.Geometries.Warning}"
                                          Fill="{StaticResource Synthetic.Brushes.Warning}"
                                          Width="14" Height="14" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Synthetic.Brushes.Warning}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5"
                                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>

                <!-- Selected Views Checklist -->
                <StackPanel Visibility="{Binding IsSelectedViewsMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Print Set Selection & Save / Save As -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Print Set:"
                                   FontSize="12"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PrintSets}"
                                  SelectedItem="{Binding SelectedPrintSet, Mode=TwoWay}"
                                  DisplayMemberPath="Name"/>
                        <Button Grid.Column="3" Content="Save"
                                Command="{Binding SavePrintSetCommand}"
                                MinWidth="64" Padding="10,4"/>
                        <Button Grid.Column="5" Content="Save As..."
                                Command="{Binding SaveAsPrintSetCommand}"
                                MinWidth="78" Padding="10,4"/>
                    </Grid>

                    <TextBlock Text="{Binding PrintSetStatusMessage}"
                               Visibility="{Binding HasPrintSetStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                               FontSize="11"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding PrintSetErrorMessage}"
                               Visibility="{Binding HasPrintSetError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               FontSize="11"
                               Foreground="{DynamicResource Synthetic.Brushes.Error}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="ViewSearchBox"
                                     Text="{Binding ViewSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Filter views by name or type..."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=ViewSearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2" Content="Select All"
                                Command="{Binding SelectAllViewsCommand}"
                                MinWidth="72" Padding="8,4"/>
                        <Button Grid.Column="4" Content="Select None"
                                Command="{Binding SelectNoneViewsCommand}"
                                MinWidth="78" Padding="8,4"/>
                        <TextBlock Grid.Column="6"
                                   Text="{Binding SelectedViewsSummary}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding FilteredViews}"
                             MaxHeight="200"
                             MinHeight="110"
                             Background="{DynamicResource Synthetic.Brushes.BackgroundBase}"
                             BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                             BorderThickness="1"
                             Padding="2"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="OnInnerScrollPreviewMouseWheel">
                        <ListBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E2D2C"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#252423"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F1F1F1"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F1F1F1"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="3"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#252423"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#2E2D2C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ViewType, StringFormat=' ({0})'}"
                                                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                                       FontSize="11.5"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Warnings}"
                                                  Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                                                        BorderBrush="{DynamicResource Synthetic.Brushes.Warning}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="4,0,0,0"
                                                        ToolTip="{Binding Description}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Synthetic.Geometries.Warning}"
                                                              Fill="{DynamicResource Synthetic.Brushes.Warning}"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Synthetic.Brushes.Warning}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 2. Site Info -->
        <Border Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Site Info"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Location:" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SitePlaceName}" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Latitude:" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatitudeDisplay}" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Longitude:" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LongitudeDisplay}" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Hemisphere:" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HemisphereDisplay}" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>

                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Timezone:" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="{Binding TimeZoneDisplay}" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                        <TextBlock Text=" · DST: " FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                        <TextBlock Text="{Binding DstStatusDisplay}" FontSize="12" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Study Dates & Solar Schedule -->
        <Border Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Study Dates &amp; Solar Schedule"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StudyDatesSummaryText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Preset & Target Year -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="68"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Study Preset:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailablePresets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>

                    <TextBlock Grid.Column="3" Text="Year:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBox Grid.Column="5"
                             Text="{Binding TargetYearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- Preset Actions (Save / Save As / Rename / Delete) -->
                <Grid Margin="110,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Save"
                            Command="{Binding SavePresetCommand}"
                            MinWidth="56" Padding="8,3"/>
                    <Button Grid.Column="2" Content="Save As..."
                            Command="{Binding SavePresetAsCommand}"
                            MinWidth="72" Padding="8,3"/>
                    <Button Grid.Column="4" Content="Rename"
                            Command="{Binding RenamePresetCommand}"
                            MinWidth="64" Padding="8,3"/>
                    <Button Grid.Column="6" Content="Delete"
                            Command="{Binding DeletePresetCommand}"
                            MinWidth="60" Padding="8,3"/>
                    <TextBlock Grid.Column="7"
                               Text="{Binding PresetBadgeText}"
                               FontSize="11"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="{Binding PresetStatusMessage}"
                           Visibility="{Binding HasPresetStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="11"
                           Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="110,4,0,0"/>

                <TextBlock Text="{Binding PresetErrorMessage}"
                           Visibility="{Binding HasPresetError, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="11"
                           Foreground="{DynamicResource Synthetic.Brushes.Error}"
                           TextWrapping="Wrap"
                           Margin="110,4,0,0"/>

                <!-- Add Astronomical Event -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Add Event:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AstronomicalEventOptions}"
                              SelectedValuePath="Kind"
                              SelectedValue="{Binding SelectedAstronomicalEventToAdd, Mode=TwoWay}"
                              DisplayMemberPath="Label"/>
                    <Button Grid.Column="3" Content="Add Event"
                            Command="{Binding AddAstronomicalDateCommand}"
                            MinWidth="76"/>
                </Grid>

                <!-- Add Custom Date -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Add Custom Date:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <DatePicker Grid.Column="1"
                                SelectedDate="{Binding CustomDateToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="3" Content="Add Date"
                            Command="{Binding AddCustomDateCommand}"
                            MinWidth="76"/>
                </Grid>

                <!-- Selected Study Dates List with Live Per-Date Schedule Preview -->
                <Border Background="{DynamicResource Synthetic.Brushes.BackgroundBase}"
                        BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                        BorderThickness="1" CornerRadius="3"
                        Padding="6" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="No study dates selected. Choose a preset or add a custom date above."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                   Margin="4"
                                   Visibility="{Binding HasNoDates, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ScrollViewer MaxHeight="165"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="OnInnerScrollPreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding StudyDates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                                                CornerRadius="3"
                                                Padding="8,5" Margin="0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.BorderNormal}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasZeroFrames}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DateLabel}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                                                    <TextBlock Text="{Binding WindowSummary}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                                               Visibility="{Binding HasValidFrames, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0"
                                                                Visibility="{Binding HasZeroFrames, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Path Data="{StaticResource Synthetic.Geometries.Warning}"
                                                              Fill="{StaticResource Synthetic.Brushes.Warning}"
                                                              Width="12" Height="12" Stretch="Uniform"
                                                              VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding ZeroFrameWarningText}"
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Synthetic.Brushes.Warning}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="Remove"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{DynamicResource Synthetic.Styles.NeutralButton}"
                                                        MinWidth="56" MinHeight="24" Padding="6,2"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Solar Schedule Parameters -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Time Increment:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding TimeIncrementOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Minutes"
                              SelectedValue="{Binding TimeStepMinutes, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Max Darkness:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="68"
                                 Text="{Binding MaxCompositeDarknessText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="% (1–95)"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Min Sun Altitude:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="68"
                                 Text="{Binding MinSunAltitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="° (0–90)"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    </StackPanel>
                </Grid>

                <!-- Partial 0-Frame Skipped Date Notice -->
                <Border Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                        BorderBrush="{DynamicResource Synthetic.Brushes.Warning}"
                        BorderThickness="1" CornerRadius="3"
                        Padding="10,7" Margin="0,8,0,0"
                        Visibility="{Binding ShowPartialZeroFramesNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Synthetic.Geometries.Warning}"
                              Fill="{StaticResource Synthetic.Brushes.Warning}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PartialZeroFramesNoticeText}"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Synthetic.Brushes.Warning}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Non-blocking All-0-Frame / Empty Dates Warning Badge -->
                <Border Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                        BorderBrush="{DynamicResource Synthetic.Brushes.Warning}"
                        BorderThickness="1" CornerRadius="3"
                        Padding="10,7" Margin="0,8,0,0"
                        Visibility="{Binding ShowZeroFramesWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Synthetic.Geometries.Warning}"
                              Fill="{StaticResource Synthetic.Brushes.Warning}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ZeroFramesWarningText}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Synthetic.Brushes.Warning}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Inline Validation Error Banner -->
                <Border Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                        BorderBrush="{DynamicResource Synthetic.Brushes.Error}"
                        BorderThickness="1" CornerRadius="3"
                        Padding="10,7" Margin="0,8,0,0"
                        Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Synthetic.Geometries.Blocked}"
                              Fill="{StaticResource Synthetic.Brushes.Error}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ValidationErrorMessage}"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Synthetic.Brushes.Error}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Output Settings -->
        <Border Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="Output Settings"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output Folder:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="3" Content="Browse..."
                            Command="{Binding BrowseOutputFolderCommand}"
                            MinWidth="82"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pixel Width:"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="78"
                                 Text="{Binding PixelWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="px (64–15000)"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="3"
                              Content="Export individual frame PNGs"
                              IsChecked="{Binding ExportIndividualFrames, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output File:"
                               FontSize="11.5" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding CompositeFileNamePreview}"
                               FontSize="11.5" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Margin="0,4,0,0"
                      Visibility="{Binding ExportIndividualFrames, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Frame Subfolder:"
                               FontSize="11.5" Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding FrameFolderPreview}"
                               FontSize="11.5" Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <CheckBox Content="Preserve view's existing Visual Style"
                          IsChecked="{Binding PreserveVisualStyle, Mode=TwoWay}"
                          ToolTip="When checked, shaded views retain their Visual Style and background using per-timestamp reference normalization; Wireframe and Rendering views always fall back to Hidden Line on pure white."
                          Margin="110,8,0,0"/>

                <TextBlock Text="{Binding VisualStyleSummaryText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                           Margin="110,4,0,0"/>
            </StackPanel>
        </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 5. Pinned Footer Actions -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{DynamicResource Synthetic.Styles.NeutralButton.Right}"
                        IsCancel="True"/>
                <Button Content="Export"
                        Command="{Binding ExportCommand}"
                        Style="{DynamicResource Synthetic.Styles.PrimaryButton}"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
