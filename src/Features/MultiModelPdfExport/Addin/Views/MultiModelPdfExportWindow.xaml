<Window x:Class="Synthetic.Features.MultiModelPdfExport.Views.MultiModelPdfExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Synthetic.Platform.UI;assembly=Synthetic.Core"
        xmlns:theme="clr-namespace:Synthetic.Platform.UI"
        xmlns:models="clr-namespace:Synthetic.Features.MultiModelPdfExport.Models;assembly=Synthetic.Core"
        xmlns:vm="clr-namespace:Synthetic.Features.MultiModelPdfExport.ViewModels;assembly=Synthetic.Core"
        Title="MULTI-MODEL PDF EXPORT"
        Width="660" Height="740" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Style="{DynamicResource SyntheticWindowStyle}"
        local:WindowChromeBehavior.EnableWindowCommands="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SyntheticThemeDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>

            <Style x:Key="RowPrintSetComboBoxStyle"
                   TargetType="ComboBox"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasRowError}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.Error}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OutputFolderTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowFolderErrorBorder}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.Error}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompactToolbarButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Padding" Value="9,3"/>
                <Setter Property="FontSize" Value="11.5"/>
            </Style>

            <Style x:Key="InlineBannerActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.BorderNormal}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinHeight" Value="22"/>
                <Setter Property="MinWidth" Value="22"/>
                <Setter Property="Padding" Value="7,2"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.AccentActive}"/>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Synthetic.Brushes.ControlSurface}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Synthetic.Brushes.BackgroundBase}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Body -->
        <Grid Grid.Row="0" Margin="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Multi-Model PDF Export"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                <TextBlock Text="Export Print Sets to PDF from the active model, linked models, or open projects (.rfa families excluded)."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 1. Projects & Print Sets Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card Header & Selection Count -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Projects &amp; Print Sets"
                                   FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SelectionSummaryTextBlock"
                                   Grid.Column="1" Text="{Binding SelectionSummaryText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Bulk Print Set Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Apply Print Set:"
                                   FontSize="12"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="BulkPrintSetComboBox"
                                  Grid.Column="1"
                                  ItemsSource="{Binding BulkPrintSetOptions}"
                                  SelectedItem="{Binding SelectedBulkPrintSetOption, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding HasBulkPrintSetOptions}"
                                  Margin="0,0,8,0"/>
                        <Button x:Name="ApplyBulkPrintSetButton"
                                Grid.Column="2"
                                Content="Apply to Match"
                                Command="{Binding ApplyBulkPrintSetCommand}"
                                Style="{StaticResource CompactToolbarButtonStyle}"
                                MinWidth="96"/>
                    </Grid>

                    <!-- Inline Dismissible Bulk Feedback Banner -->
                    <Border x:Name="BulkFeedbackBanner"
                            Grid.Row="2"
                            Visibility="{Binding HasBulkFeedbackBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,6" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.BorderNormal}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BulkFeedbackKind}" Value="{x:Static vm:MultiModelPdfBulkFeedbackKind.Success}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BulkFeedbackKind}" Value="{x:Static vm:MultiModelPdfBulkFeedbackKind.Warning}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.Warning}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,7,0">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource Synthetic.Geometries.Success}"/>
                                        <Setter Property="Fill" Value="{DynamicResource Synthetic.Brushes.Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BulkFeedbackKind}" Value="{x:Static vm:MultiModelPdfBulkFeedbackKind.Warning}">
                                                <Setter Property="Data" Value="{StaticResource Synthetic.Geometries.Warning}"/>
                                                <Setter Property="Fill" Value="{DynamicResource Synthetic.Brushes.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <TextBlock x:Name="BulkFeedbackMessageText"
                                       Grid.Column="1"
                                       Text="{Binding BulkFeedbackMessage}"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BulkFeedbackKind}" Value="{x:Static vm:MultiModelPdfBulkFeedbackKind.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button x:Name="UncheckUnmatchedButton"
                                        Content="Uncheck unmatched"
                                        Command="{Binding UncheckUnmatchedProjectsCommand}"
                                        Visibility="{Binding ShowUncheckUnmatchedButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource InlineBannerActionButtonStyle}"
                                        Margin="0,0,6,0"/>
                                <Button x:Name="DismissBulkFeedbackButton"
                                        Content="×"
                                        Command="{Binding DismissBulkFeedbackCommand}"
                                        ToolTip="Dismiss"
                                        Style="{StaticResource InlineBannerActionButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Live Filter & Quick-Select Bar -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="ProjectFilterTextBox"
                                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Filter projects..."
                                       FontSize="12"
                                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=ProjectFilterTextBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button x:Name="SelectAllVisibleButton"
                                Grid.Column="1"
                                Content="All"
                                Command="{Binding SelectAllVisibleCommand}"
                                Style="{StaticResource CompactToolbarButtonStyle}"
                                Margin="6,0,0,0"/>
                        <Button x:Name="SelectActiveAndLinksVisibleButton"
                                Grid.Column="2"
                                Content="Active + Links"
                                Command="{Binding SelectActiveAndLinksVisibleCommand}"
                                Style="{StaticResource CompactToolbarButtonStyle}"
                                MinWidth="88"
                                Margin="6,0,0,0"/>
                        <Button x:Name="SelectNoneVisibleButton"
                                Grid.Column="3"
                                Content="None"
                                Command="{Binding SelectNoneVisibleCommand}"
                                Style="{StaticResource CompactToolbarButtonStyle}"
                                MinWidth="48"
                                Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Flat Table -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource Synthetic.Brushes.BackgroundBase}"
                            BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="216"/>
                                        <ColumnDefinition Width="94"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="MasterHeaderCheckBox"
                                              Grid.Column="0"
                                              IsChecked="{Binding AllVisibleChecked, Mode=OneWay}"
                                              Command="{Binding ToggleAllVisibleCommand}"
                                              IsEnabled="{Binding HasVisibleEligibleRows}"
                                              ToolTip="Toggle all visible eligible projects"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="PROJECT / SOURCE"
                                               FontSize="10.5" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="PRINT SET"
                                               FontSize="10.5" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                                    <TextBlock Grid.Column="3" Text="VIEWS"
                                               FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding VisibleRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                                                        BorderThickness="0,0,0,1"
                                                        MinHeight="44"
                                                        ToolTip="{Binding RowTooltipText}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Synthetic.Brushes.ControlSurface}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#292827"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsDisabledRow}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.25"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <!-- Transient #C2A26A left mismatch accent stripe -->
                                                        <Border x:Name="BulkMismatchAccentStripe"
                                                                HorizontalAlignment="Left"
                                                                Width="3"
                                                                Background="{DynamicResource Synthetic.Brushes.Warning}"
                                                                Visibility="{Binding HasBulkMismatchAccent, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                        <Grid Margin="8,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="216"/>
                                                                <ColumnDefinition Width="94"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Checkbox -->
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsEligible}"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center"/>

                                                    <!-- Project / Source -->
                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DocumentTitle}"
                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.BorderNormal}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActiveOrigin}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource Synthetic.Brushes.AccentActive}"/>
                                                                                <Setter Property="Background" Value="#14E65100"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding OriginBadgeText}"
                                                                           FontSize="10" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActiveOrigin}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.AccentActive}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsOpenOrigin}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding StorageDisplayText}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding CollisionCueText}"
                                                                       ToolTip="{Binding CollisionTooltipText}"
                                                                       ToolTipService.ShowDuration="20000"
                                                                       Background="Transparent"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsCollisionDisambiguated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Print Set Selector or Disabled Reason -->
                                                    <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <ComboBox Style="{StaticResource RowPrintSetComboBoxStyle}"
                                                                  ItemsSource="{Binding PrintSetOptions}"
                                                                  SelectedItem="{Binding SelectedPrintSetOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  Visibility="{Binding IsEligible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding DisabledStatusText}"
                                                                   FontSize="11.5" FontStyle="Italic"
                                                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsDisabledRow, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>

                                                    <!-- Views / Blocking Indicator -->
                                                    <StackPanel Grid.Column="3"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <!-- Normal Views Count -->
                                                        <TextBlock Text="{Binding ViewsDisplayText}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right"
                                                                   Visibility="{Binding HasNormalViewCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextPrimary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Skip Badge -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,2,0,0"
                                                                    Background="Transparent"
                                                                    Cursor="Help"
                                                                    ToolTipService.ShowDuration="20000"
                                                                    ToolTip="{Binding SkippedTooltipText}"
                                                                    Visibility="{Binding HasSkippedViews, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Data="{StaticResource Synthetic.Geometries.Warning}"
                                                                  Fill="{DynamicResource Synthetic.Brushes.Warning}"
                                                                  Width="11" Height="11" Stretch="Uniform"
                                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding SkippedBadgeText}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource Synthetic.Brushes.Warning}"/>
                                                        </StackPanel>

                                                        <!-- Missing Print Set -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Visibility="{Binding HasMissingPrintSet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Data="{StaticResource Synthetic.Geometries.Blocked}"
                                                                  Fill="{DynamicResource Synthetic.Brushes.Error}"
                                                                  Width="11" Height="11" Stretch="Uniform"
                                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Missing"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       Foreground="{DynamicResource Synthetic.Brushes.Error}"/>
                                                        </StackPanel>

                                                        <!-- 0 Views -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Visibility="{Binding HasZeroPrintableViews, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Path Data="{StaticResource Synthetic.Geometries.Blocked}"
                                                                  Fill="{DynamicResource Synthetic.Brushes.Error}"
                                                                  Width="11" Height="11" Stretch="Uniform"
                                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="0 views"
                                                                       FontSize="12" FontWeight="Bold"
                                                                       Foreground="{DynamicResource Synthetic.Brushes.Error}"/>
                                                        </StackPanel>

                                                            <!-- Placeholder Dash -->
                                                            <TextBlock Text="—"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                                                       Visibility="{Binding ShowDashViewsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoMatchingProjectsText"
                                               Text="No matching projects."
                                               FontSize="12"
                                               Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="18"
                                               Visibility="{Binding HasNoVisibleRows, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. PDF Export & Output Card -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PDF Export &amp; Output"
                                   FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActiveSetupSourceSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PDF Export Setup:"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding PdfSetups}"
                                  SelectedItem="{Binding SelectedPdfSetup, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="File Mode:"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="Combined PDF per document"
                                         GroupName="MultiModelPdfFileMode"
                                         IsChecked="{Binding FileMode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:MultiModelPdfFileMode.CombinedPerDocument}}"
                                         Margin="0,0,16,0"
                                         VerticalAlignment="Center"/>
                            <RadioButton Content="Separate PDFs per view/sheet"
                                         GroupName="MultiModelPdfFileMode"
                                         IsChecked="{Binding FileMode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:MultiModelPdfFileMode.SeparatePerViewSheet}}"
                                         VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding OutputPreviewText, StringFormat='Preview: {0}'}"
                                   ToolTip="{Binding OutputPreviewText}"
                                   FontFamily="Consolas, Cascadia Mono"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Output Folder:"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                        <Grid Grid.Row="6" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource OutputFolderTextBoxStyle}"
                                     Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Browse..."
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    MinWidth="74" Padding="10,4"/>
                        </Grid>

                        <TextBlock Grid.Row="8" Grid.Column="1"
                                   Text="Folder will be created on export"
                                   FontSize="11"
                                   Foreground="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Blocking Validation Banner (NO_PROJECTS suppressed) -->
            <Border Grid.Row="3"
                    Visibility="{Binding HasErrorBanner, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource Synthetic.Brushes.ControlSurfaceLighter}"
                    BorderBrush="{DynamicResource Synthetic.Brushes.Error}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="10,6" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="{StaticResource Synthetic.Geometries.Blocked}"
                          Fill="{DynamicResource Synthetic.Brushes.Error}"
                          Width="13" Height="13" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PrimaryErrorBannerText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource Synthetic.Brushes.Error}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Pinned Footer -->
        <Border Grid.Row="1"
                Background="{DynamicResource Synthetic.Brushes.ControlSurface}"
                BorderBrush="{DynamicResource Synthetic.Brushes.BorderNormal}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterStatusKind}" Value="{x:Static vm:MultiModelPdfFooterStatusKind.Warning}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource Synthetic.Geometries.Warning}"/>
                                        <Setter Property="Fill" Value="{DynamicResource Synthetic.Brushes.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FooterStatusKind}" Value="{x:Static vm:MultiModelPdfFooterStatusKind.Success}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Data" Value="{StaticResource Synthetic.Geometries.Success}"/>
                                        <Setter Property="Fill" Value="{DynamicResource Synthetic.Brushes.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <TextBlock Text="{Binding FooterStatusText}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.TextSecondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterStatusKind}" Value="{x:Static vm:MultiModelPdfFooterStatusKind.Warning}">
                                        <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FooterStatusKind}" Value="{x:Static vm:MultiModelPdfFooterStatusKind.Success}">
                                        <Setter Property="Foreground" Value="{DynamicResource Synthetic.Brushes.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{DynamicResource Synthetic.Styles.NeutralButton}"
                            IsCancel="True"
                            Margin="0,0,8,0"/>
                    <Button Content="{Binding ExportButtonText}"
                            Command="{Binding ExportCommand}"
                            Style="{DynamicResource Synthetic.Styles.PrimaryButton}"
                            MinWidth="112"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
