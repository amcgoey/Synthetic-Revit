<Project>
  <PropertyGroup>
    <GenerateMSBuildEditorConfigFile>false</GenerateMSBuildEditorConfigFile>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <RootNamespace>Synthetic</RootNamespace>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFrameworks)' == ''">false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Synthetic.Bootstrap'))">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SyntheticIsolatedBuildRoot)' != ''">
    <SyntheticRunId Condition="'$(SyntheticRunId)' == ''">default</SyntheticRunId>
    <SkipDeployAddin>true</SkipDeployAddin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SyntheticIsolatedBuildRoot)' != '' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <_SyntheticIsolatedBuildRootTrimmed>$(SyntheticIsolatedBuildRoot.TrimEnd('\').TrimEnd('/'))</_SyntheticIsolatedBuildRootTrimmed>
    <BaseIntermediateOutputPath>$(_SyntheticIsolatedBuildRootTrimmed)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <OutputPath>$(_SyntheticIsolatedBuildRootTrimmed)\bin\$(MSBuildProjectName)_$(SyntheticRunId)\</OutputPath>
    <OutDir Condition="'$(TargetFrameworks)' == ''">$(OutputPath)</OutDir>
  </PropertyGroup>

  <PropertyGroup>
    <RepoOutputRoot Condition="'$(RepoOutputRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\output'))</RepoOutputRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SyntheticIsolatedBuildRoot)' == '' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <OutputPath Condition="$(MSBuildProjectName.StartsWith('Synthetic.Bootstrap'))">$(RepoOutputRoot)\Synthetic\Bootstrap\v1\</OutputPath>
    <OutputPath Condition="$(MSBuildProjectName.StartsWith('Synthetic20'))">$(RepoOutputRoot)\Synthetic\Payload\$(MSBuildProjectName.Substring(9))\</OutputPath>
  </PropertyGroup>
</Project>
