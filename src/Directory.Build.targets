<Project>
  <PropertyGroup Condition="'$(GenerateDocumentationFile)' == 'true' And '$(IsBootstrapProject)' != 'true'">
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(GenerateDocumentationFile)' == 'true' And '$(IsBootstrapProject)' != 'true'">
    <DocFileItem Remove="@(DocFileItem)" />
    <DocFileItem Include="$(DocumentationFile)" />
    <FinalDocFile Remove="@(FinalDocFile)" />
    <FinalDocFile Include="@(DocFileItem->'$(OutDir)%(Filename)%(Extension)')" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsBootstrapProject)' != 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)SyntheticShared\**\*.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="$(MSBuildThisFileDirectory)SyntheticShared\**\*.xaml"
          Link="%(RecursiveDir)%(Filename)%(Extension)"
          Generator="MSBuild:Compile"
          SubType="Designer" />
    <Content Include="$(MSBuildThisFileDirectory)SyntheticShared\Assets\**\*.*"
             Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)SyntheticShared\SyntheticSettings.template.json"
             Link="SyntheticSettings.template.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)SyntheticShared\SyntheticSettings.json"
             Condition="Exists('$(MSBuildThisFileDirectory)SyntheticShared\SyntheticSettings.json')"
             Link="SyntheticSettings.json"
             CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)SyntheticShared\SyntheticWorksets.xlsx"
          Link="SyntheticWorksets.xlsx"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsBootstrapProject)' != 'true' And '$(RevitVersion)' != ''">
    <Reference Include="eTransmitForRevitDB"
               Condition="Exists('C:\Program Files\Autodesk\eTransmit for Revit $(RevitVersion)\eTransmitForRevitDB.dll')">
      <HintPath>C:\Program Files\Autodesk\eTransmit for Revit $(RevitVersion)\eTransmitForRevitDB.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="eTransmitForRevitDB"
               Condition="!Exists('C:\Program Files\Autodesk\eTransmit for Revit $(RevitVersion)\eTransmitForRevitDB.dll') And Exists('C:\Program Files\Autodesk\Revit $(RevitVersion)\AddIns\eTransmitForRevit\eTransmitForRevitDB.dll')">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\AddIns\eTransmitForRevit\eTransmitForRevitDB.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(IsBootstrapProject)' != 'true' And '$(RevitVersion)' != '' And Exists('$(MSBuildThisFileDirectory)Synthetic.Bootstrap$(RevitVersion)\Synthetic.Bootstrap$(RevitVersion).csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Synthetic.Bootstrap$(RevitVersion)\Synthetic.Bootstrap$(RevitVersion).csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="CleanLegacyFlatOutputs"
          BeforeTargets="Build;Clean"
          Condition="'$(SyntheticIsolatedBuildRoot)' == '' And '$(IsBootstrapProject)' != 'true'">
    <PropertyGroup>
      <_LegacySyntheticFlatDir>$(RepoOutputRoot)\Synthetic</_LegacySyntheticFlatDir>
    </PropertyGroup>
    <ItemGroup>
      <_LegacyFlatFiles Include="$(_LegacySyntheticFlatDir)\Synthetic202*.*" />
      <_LegacyFlatFiles Include="$(_LegacySyntheticFlatDir)\Newtonsoft.Json.*" />
      <_LegacyFlatFiles Include="$(_LegacySyntheticFlatDir)\SyntheticSettings*.json" />
      <_LegacyFlatFiles Include="$(_LegacySyntheticFlatDir)\SyntheticWorksets.xlsx" />
      <_LegacyFlatFiles Include="$(_LegacySyntheticFlatDir)\MergeDuplicates_Step6_ExecutionResult.json" />
      <_LegacyFlatFiles Include="$(RepoOutputRoot)\Manifest for Deploy\Synthetic2022.addin" />
      <_LegacyFlatFiles Include="$(RepoOutputRoot)\Deploy-LocalAddins.bat" />
      <_LegacyFlatFiles Include="$(RepoOutputRoot)\Deploy-To-INC-Server.bat" />
    </ItemGroup>
    <Delete Files="@(_LegacyFlatFiles)" ContinueOnError="true" />
    <RemoveDir Directories="$(_LegacySyntheticFlatDir)\Assets"
               Condition="Exists('$(_LegacySyntheticFlatDir)\Assets')"
               ContinueOnError="true" />
  </Target>

  <!-- Single-source .addin manifest generation and deployment for Debug and Release -->
  <Target Name="GenerateRevitAddinManifest"
          AfterTargets="Build"
          Condition="'$(IsBootstrapProject)' != 'true' And '$(RevitVersion)' != ''">
    <PropertyGroup>
      <_BootstrapAssemblyName>Synthetic.Bootstrap$(RevitVersion).dll</_BootstrapAssemblyName>
      <_AddinAssemblyPath Condition="'$(Configuration)' == 'Debug'">$(RepoOutputRoot)\Synthetic\Bootstrap\v1\$(_BootstrapAssemblyName)</_AddinAssemblyPath>
      <_AddinAssemblyPath Condition="'$(Configuration)' != 'Debug' And $([MSBuild]::VersionLessThan($(RevitVersion), '2027'))">C:\ProgramData\Autodesk\Revit\Addins\Synthetic\Bootstrap\v1\$(_BootstrapAssemblyName)</_AddinAssemblyPath>
      <_AddinAssemblyPath Condition="'$(Configuration)' != 'Debug' And $([MSBuild]::VersionGreaterThanOrEquals($(RevitVersion), '2027'))">C:\Program Files\Autodesk\Revit\Addins\Synthetic\Bootstrap\v1\$(_BootstrapAssemblyName)</_AddinAssemblyPath>
      <_EmitUseRevitContext>$([MSBuild]::VersionGreaterThanOrEquals($(RevitVersion), '2026'))</_EmitUseRevitContext>
      <_AddinManifestOutputPath Condition="'$(AddinManifestOutputPath)' != ''">$(AddinManifestOutputPath)</_AddinManifestOutputPath>
      <_AddinManifestOutputPath Condition="'$(AddinManifestOutputPath)' == ''">$(TargetDir)Synthetic$(RevitVersion).addin</_AddinManifestOutputPath>
      <_AddinManifestOutputDir>$([System.IO.Path]::GetDirectoryName('$(_AddinManifestOutputPath)'))</_AddinManifestOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <_AddinManifestLine Remove="@(_AddinManifestLine)" />
      <_AddinManifestLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <_AddinManifestLine Include="&lt;RevitAddIns&gt;" />
      <_AddinManifestLine Include="  &lt;ManifestSettings&gt;" Condition="'$(_EmitUseRevitContext)' == 'true'" />
      <_AddinManifestLine Include="    &lt;UseRevitContext&gt;True&lt;/UseRevitContext&gt;" Condition="'$(_EmitUseRevitContext)' == 'true'" />
      <_AddinManifestLine Include="  &lt;/ManifestSettings&gt;" Condition="'$(_EmitUseRevitContext)' == 'true'" />
      <_AddinManifestLine Include="  &lt;AddIn Type=&quot;Application&quot;&gt;" />
      <_AddinManifestLine Include="    &lt;Name&gt;Synthetic&lt;/Name&gt;" />
      <_AddinManifestLine Include="    &lt;Assembly&gt;$(_AddinAssemblyPath)&lt;/Assembly&gt;" />
      <_AddinManifestLine Include="    &lt;FullClassName&gt;Synthetic.Bootstrap.BootstrapApp&lt;/FullClassName&gt;" />
      <_AddinManifestLine Include="    &lt;ClientId&gt;4fd5b26e-1325-460f-97b1-878804070868&lt;/ClientId&gt;" />
      <_AddinManifestLine Include="    &lt;VendorId&gt;net.amcgoey&lt;/VendorId&gt;" />
      <_AddinManifestLine Include="    &lt;VendorDescription&gt;Synthetic by Arthur McGoey&lt;/VendorDescription&gt;" />
      <_AddinManifestLine Include="  &lt;/AddIn&gt;" />
      <_AddinManifestLine Include="&lt;/RevitAddIns&gt;" />
    </ItemGroup>

    <Message Text="Generating $(Configuration) .addin manifest for Revit $(RevitVersion): $(_AddinManifestOutputPath) -> $(_AddinAssemblyPath)" Importance="high" />

    <MakeDir Directories="$(_AddinManifestOutputDir)" Condition="'$(_AddinManifestOutputDir)' != ''" />
    <WriteLinesToFile File="$(_AddinManifestOutputPath)"
                      Lines="@(_AddinManifestLine)"
                      Overwrite="true"
                      Encoding="utf-8" />

    <MakeDir Directories="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)"
             Condition="'$(SkipDeployAddin)' != 'true' And '$(Configuration)' == 'Debug'" />
    <Copy SourceFiles="$(_AddinManifestOutputPath)"
          DestinationFiles="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\Synthetic$(RevitVersion).addin"
          OverwriteReadOnlyFiles="true"
          Condition="'$(SkipDeployAddin)' != 'true' And '$(Configuration)' == 'Debug'" />

    <MakeDir Directories="$(RepoOutputRoot)\Manifest for Deploy"
             Condition="'$(SkipDeployAddin)' != 'true' And '$(Configuration)' != 'Debug'" />
    <Copy SourceFiles="$(_AddinManifestOutputPath)"
          DestinationFiles="$(RepoOutputRoot)\Manifest for Deploy\Synthetic$(RevitVersion).addin"
          OverwriteReadOnlyFiles="true"
          Condition="'$(SkipDeployAddin)' != 'true' And '$(Configuration)' != 'Debug'" />
  </Target>

  <Target Name="AfterClean" Condition="'$(SkipDeployAddin)' != 'true' And '$(IsBootstrapProject)' != 'true' And '$(RevitVersion)' != ''">
    <Delete Files="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\Synthetic$(RevitVersion).addin" />
  </Target>

  <Target Name="SignDebugBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <WindowsKitsRoot>$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots@KitsRoot10)</WindowsKitsRoot>
      <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', '', 'Registry64', 'Registry32'))</WindowsKitsRoot>
      <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == ''">C:\Program Files (x86)\Windows Kits\10\</WindowsKitsRoot>

      <!-- Trim trailing backslash to prevent double-backslash issues in wildcard matching -->
      <WindowsKitsRootTrimmed>$(WindowsKitsRoot.TrimEnd('\'))</WindowsKitsRootTrimmed>
    </PropertyGroup>

    <ItemGroup>
      <SignToolPaths Include="$(WindowsKitsRootTrimmed)\bin\10.*\x64\signtool.exe" />
      <SignToolPaths Include="$(WindowsKitsRootTrimmed)\bin\x64\signtool.exe" Condition="Exists('$(WindowsKitsRootTrimmed)\bin\x64\signtool.exe')" />
    </ItemGroup>

    <PropertyGroup>
      <SignToolExe>%(SignToolPaths.Identity)</SignToolExe>
    </PropertyGroup>

    <Message Importance="High" Text="Dynamically discovered signtool at: $(SignToolExe)" />
    <Message Importance="High" Text="Signing local Debug build with self-signed certificate..." />

    <Exec Command="&quot;$(SignToolExe)&quot; sign /n &quot;Synthetic&quot; /fd SHA256 /a &quot;$(TargetPath)&quot;"
          Condition="Exists('$(SignToolExe)')"
          IgnoreExitCode="true" />
  </Target>
</Project>
