<Project>
  <PropertyGroup>
    <GenerateMSBuildEditorConfigFile>false</GenerateMSBuildEditorConfigFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'RevitAPIMock' And '$(MSBuildProjectName)' != 'RevitAPIUIMock'">
    <BaseIntermediateOutputPath>$(LocalAppData)\Temp\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <OutputPath>$(LocalAppData)\Temp\bin\$(MSBuildProjectName)\</OutputPath>
  </PropertyGroup>
</Project>