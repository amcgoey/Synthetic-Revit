<Project>
  <ItemGroup Condition="'$(IsRevitTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Fixtures\Shared\TestPathHelper.cs"
             Link="Fixtures\TestPathHelper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Fixtures\Shared\TypedCategoryAttributes.cs"
             Link="Fixtures\TypedCategoryAttributes.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)SyntheticTests.Shared\**\*.cs"
             Exclude="$(MSBuildThisFileDirectory)SyntheticTests.Shared\Modules\SheetIndex\**\*.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildThisFileDirectory)SyntheticTests.Shared\Assets\**\*.json"
          Link="Assets\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="NUnit.Open" Value="true" />
    <AssemblyMetadata Include="NUnit.Close" Value="true" />
    <AssemblyMetadata Include="NUnit.Timeout" Value="10" />
    <AssemblyMetadata Include="ricaun.RevitTest.Application.Tasks.Timeout" Value="5" />
  </ItemGroup>

  <Target Name="SignDebugBuild"
          AfterTargets="CoreCompile"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(IsRevitTestProject)' == 'true' And '$(Configuration)' == 'Debug' And '$(DesignTimeBuild)' != 'true'"
          Inputs="@(IntermediateAssembly)"
          Outputs="$(IntermediateOutputPath)$(AssemblyName).signed.stamp">
    <PropertyGroup>
      <WindowsKitsRoot>$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots@KitsRoot10)</WindowsKitsRoot>
      <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', '', 'Registry64', 'Registry32'))</WindowsKitsRoot>
      <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == ''">C:\Program Files (x86)\Windows Kits\10\</WindowsKitsRoot>

      <!-- Trim trailing backslash to prevent double-backslash issues in wildcard matching -->
      <WindowsKitsRootTrimmed>$(WindowsKitsRoot.TrimEnd('\'))</WindowsKitsRootTrimmed>
    </PropertyGroup>

    <ItemGroup>
      <SignToolPaths Include="$(WindowsKitsRootTrimmed)\bin\10.*\x64\signtool.exe" />
      <SignToolPaths Include="$(WindowsKitsRootTrimmed)\bin\x64\signtool.exe" Condition="Exists('$(WindowsKitsRootTrimmed)\bin\x64\signtool.exe')" />
    </ItemGroup>

    <PropertyGroup>
      <SignToolExe>%(SignToolPaths.Identity)</SignToolExe>
      <_SignStampFile>$(IntermediateOutputPath)$(AssemblyName).signed.stamp</_SignStampFile>
    </PropertyGroup>

    <Message Importance="High" Text="Dynamically discovered signtool at: $(SignToolExe)" />
    <Message Importance="High" Text="Signing local Debug build with self-signed certificate..." />

    <Exec Command="&quot;$(SignToolExe)&quot; sign /n &quot;Synthetic&quot; /fd SHA256 /a &quot;@(IntermediateAssembly)&quot;"
          Condition="Exists('$(SignToolExe)') And Exists('@(IntermediateAssembly)')"
          IgnoreExitCode="true" />
    <Touch Files="$(_SignStampFile)" AlwaysCreate="true" Condition="Exists('@(IntermediateAssembly)')" />
    <ItemGroup>
      <FileWrites Include="$(_SignStampFile)" />
    </ItemGroup>
  </Target>

  <Target Name="WriteSyntheticProjectRoot"
          AfterTargets="Build"
          Condition="'$(IsTestProject)' == 'true' And '$(IsCrossTargetingBuild)' != 'true'">
    <WriteLinesToFile File="$(TargetDir)synthetic_project_root.txt"
                      Lines="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))"
                      Overwrite="true"
                      Encoding="utf-8" />
  </Target>
</Project>
